// LinguasudApp — Datenbankschema (PostgreSQL)
// Prisma 8 liest dieses Schema als Contract-Quelle: nach jeder Änderung
// `pnpm db:generate` (contract emit) laufen lassen und mit `pnpm db:plan`
// + `pnpm db:migrate` migrieren.
//
// Plan: Modul 3 (Personenverwaltung) führt die Person-Kartei ein; jeder User
// wird dann über User.personId einer Person zugeordnet (E-Mail = Login bleibt
// auf beiden Seiten synchron). Modul 1 hält das Schema bewusst auf das
// Login-/Rechtesystem beschränkt.

datasource db {
  provider = "postgresql"
}

/// Die 5 Rollen des Pflichtenhefts — Mehrfachrollen möglich.
enum Role {
  ADMIN
  CHEF
  BUERO
  LEHRPERSON
  TEILNEHMER
}

model User {
  id                 String    @id @default(cuid())
  email              String    @unique // normalisiert (klein, getrimmt) — = Login
  firstName          String
  lastName           String
  roles              Role[]    @default([])
  /// bcrypt-Hash; null, wenn noch kein Passwort gesetzt wurde (Konto wartet auf Ersteinrichtung per E-Mail-Link).
  passwordHash       String?
  isActive           Boolean   @default(true)
  /// true nach Kontoeinrichtung/Admin-Reset: erzwingt Passwortwechsel nach der nächsten Anmeldung.
  mustChangePassword Boolean   @default(true)
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  /// Verknüpfte Person der Kartei (Modul 3). E-Mail bleibt auf beiden Seiten synchron.
  personId           String?   @unique
  person             Person?   @relation(fields: [personId], references: [id], onDelete: SetNull)

  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  auditLogsAsActor    AuditLog[]
  personNotizen       PersonNotiz[]

  @@index([isActive])
}

model Session {
  id         String   @id @default(cuid())
  /// SHA-256 des Cookie-Tokens (Base64url). Der Klartext-Token verlässt den Server nur im Cookie.
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  /// Absolute Höchstlaufzeit; zusätzlich gilt ein Idle-Fenster (Verlängerung bei Aktivität).
  expiresAt  DateTime

  @@index([userId])
  @@index([expiresAt])
}

/// Login- und Reset-Versuche für den Brute-Force-Schutz (fensterbasierte Auswertung).
enum AuthEventKind {
  LOGIN
  PASSWORD_RESET
}

model LoginAttempt {
  id        String        @id @default(cuid())
  kind      AuthEventKind @default(LOGIN)
  email     String // normalisiert
  ip        String?
  success   Boolean
  createdAt DateTime      @default(now())

  @@index([kind, email, createdAt])
  @@index([kind, ip, createdAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  /// SHA-256 des Tokens aus dem E-Mail-Link.
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model AuditLog {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  /// Handelnder Account; null für System/Bootstrap. E-Mail zusätzlich als Snapshot.
  actorUserId String?
  actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  actorEmail  String?
  /// Z.B. "user.login", "user.create", "standort.create"
  action      String
  entity      String?
  entityId    String?
  summary     String
  details     Json?
  ip          String?
  userAgent   String?

  @@index([createdAt])
  @@index([actorUserId, createdAt])
  @@index([entity, entityId])
  @@index([action, createdAt])
}

// ————————————————————————————————————————————————————————————————
// Modul 2 — Stammdaten
// Regel (Pflichtenheft): anlegen · aktivieren/deaktivieren ·
// löschen nur wenn unbenutzt · archivieren. Preise jederzeit anpassbar
// (Änderungen laufen über den Audit-Log).
// ————————————————————————————————————————————————————————————————

/// Schlüssel-Wert-Einstellungen (z.B. Seed-Marker, später OpenRouter-Key).
model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Standort der Sprachschule (Hierarchie Standort → Etage → Raum).
model Standort {
  id         String    @id @default(cuid())
  name       String    @unique // z.B. "Vorstadt 18"
  strasse    String
  plz        String
  ort        String
  active     Boolean   @default(true)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  etagen     Etage[]

  @@index([active])
}

model Etage {
  id         String   @id @default(cuid())
  standortId String
  standort   Standort @relation(fields: [standortId], references: [id], onDelete: Cascade)
  /// z.B. "1. Stock"
  name       String
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  raeume     Raum[]

  @@unique([standortId, name])
}

model Raum {
  id         String    @id @default(cuid())
  etageId    String
  etage      Etage     @relation(fields: [etageId], references: [id], onDelete: Cascade)
  /// Raumname, z.B. "Oxford"
  name       String
  /// Sitzplatzzahl
  seats      Int
  active     Boolean   @default(true)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([etageId, name])
}

model Sprache {
  id         String    @id @default(cuid())
  name       String    @unique // Deutsch, Englisch, …
  /// Kürzel für Kurscodes, z.B. DE, EN
  code       String    @unique
  active     Boolean   @default(true)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  qualifikationen Lehrqualifikation[]
}

/// Niveaustufen (A1 … C2), Sortierung frei definierbar.
model Niveau {
  id         String    @id @default(cuid())
  code       String    @unique // A1, A2, B1, …
  name       String? // optionale Bezeichnung
  sortOrder  Int       @default(0)
  active     Boolean   @default(true)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  qualifikationen Lehrqualifikation[]
}

/// Kursarten: Einzel, 2er, 3er, 4er, 6er, Online, Firmenkurs — beliebig erweiterbar.
model Kursart {
  id         String    @id @default(cuid())
  name       String    @unique
  /// Übliche Teilnehmerzahl; null = individuell (Firmenkurs).
  maxParticipants Int?
  /// Online-Kurse: Raum optional (mal Schulungsraum, mal von zu Hause).
  requiresRoom    Boolean   @default(true)
  sortOrder       Int       @default(0)
  active          Boolean   @default(true)
  archivedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  preise          Preis[]
}

/// Lektionsdauern in Minuten (45, 60, 90, …).
model Lektionsdauer {
  id         String    @id @default(cuid())
  minuten    Int       @unique
  active     Boolean   @default(true)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  preise     Preis[]
}

/// Tarifstufen: Hochtarif = 14 Lektionen/Paket (über Mittag/Abend),
/// Niedertarif = 15 Lektionen/Paket (Vormittag/Nachmittag).
/// Zeitfenster "HH:mm" bestimmen die Standard-Ableitung nach Tageszeit
/// (Modul 5); das Büro kann immer übersteuern.
model Tarifstufe {
  id                String  @id @default(cuid())
  name              String  @unique // "Hochtarif", "Niedertarif"
  lessonsPerPackage Int
  /// Gilt ein Kursstart in diesem Fenster als Hochtarif? (Mittagsfenster von–bis)
  middayFrom        String?
  middayTo          String?
  /// Abendfenster ab (Hochtarif); Vormittag/Nachmittag = Rest des Tages.
  eveningFrom       String?
  active            Boolean   @default(true)
  archivedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  preise            Preis[]
}

/// Preisliste: Betrag je Kursart × Lektionsdauer × Tarifstufe — jederzeit anpassbar.
model Preis {
  id             String       @id @default(cuid())
  kursartId      String
  kursart        Kursart      @relation(fields: [kursartId], references: [id], onDelete: Cascade)
  lektionsdauerId String
  lektionsdauer  Lektionsdauer @relation(fields: [lektionsdauerId], references: [id], onDelete: Cascade)
  tarifstufeId   String
  tarifstufe     Tarifstufe   @relation(fields: [tarifstufeId], references: [id], onDelete: Cascade)
  amountChf      Decimal      @db.Decimal(8, 2)

  @@unique([kursartId, lektionsdauerId, tarifstufeId])
}

/// Kostenträger: Firmen und öffentliche Einrichtungen (Rechnungsempfänger).
enum KostentraegerArt {
  FIRMA
  OEFFENTLICHE_EINRICHTUNG
}

model Kostentraeger {
  id            String           @id @default(cuid())
  art           KostentraegerArt
  name          String
  kundennummer  String           @unique
  strasse       String
  plz           String
  ort           String
  active        Boolean          @default(true)
  archivedAt    DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([name])
  @@index([active])
}

// ————————————————————————————————————————————————————————————————
// Modul 3 — Personenverwaltung (Kartei)
// Eine Kartei für alle: Teilnehmende, Interessent/innen, Lehrpersonen,
// Kinder, Büro-/Schulpersonal. Status-Laufbahn laut Pflichtenheft:
// Interessent/in → aktiv → inaktiv («Interessent» wird bei der Anmeldung,
// Modul 5, weiterverwendet).
// ————————————————————————————————————————————————————————————————

/// Lebenszyklus einer Person in der Kartei.
enum PersonStatus {
  INTERESSENT
  AKTIV
  INAKTIV
}

/// Anrede/Geschlecht — zwingend laut Pflichtenheft (Herr/Frau/divers).
enum Anrede {
  HERR
  FRAU
  DIVERS
}

model Person {
  id        String       @id @default(cuid())
  status    PersonStatus @default(INTERESSENT)
  anrede    Anrede
  vorname   String
  nachname  String
  /// Kontakt-E-Mail; bei verknüpftem Konto synchron mit User.email (= Login).
  email     String?
  strasse   String?
  plz       String?
  ort       String?
  /// Abweichende Rechnungsadresse (Modul 9); komplett leer = Postadresse gilt auch für Rechnungen.
  rechnungStrasse String?
  rechnungPlz     String?
  rechnungOrt     String?

  /// Zwei Telefonnummern mit Messenger-Flags.
  telefon1  String?
  whatsapp1 Boolean   @default(false)
  signal1   Boolean   @default(false)
  telefon2  String?
  whatsapp2 Boolean   @default(false)
  signal2   Boolean   @default(false)

  /// Lehrperson-Führung: eindeutiges Kürzel (automatisch aus Vor-/Nachname,
  /// Suffix bei Doppelung) + Qualifikationen Sprache × Niveau.
  istLehrperson Boolean @default(false)
  kuerzel       String? @unique

  /// Verknüpftes Login-Konto (null = noch kein Konto).
  user User?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notizen         PersonNotiz[]
  elternLinks     PersonBeziehung[] @relation("Kind") // diese Person ist das Kind
  kinderLinks     PersonBeziehung[] @relation("Erziehungsberechtigte") // diese Person ist Elternteil
  qualifikationen Lehrqualifikation[]

  @@index([status])
  @@index([nachname, vorname])
}

/// CRM-Notiz zu einer Person — mit Autor und Datum (Pflichtenheft).
model PersonNotiz {
  id           String   @id @default(cuid())
  personId     String
  person       Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  text         String
  /// Autor-Konto; der Name wird als Snapshot festgehalten, damit Notizen auch
  /// nach Kontolöschung zuordenbar bleiben.
  authorUserId String?
  authorUser   User?    @relation(fields: [authorUserId], references: [id], onDelete: SetNull)
  authorName   String
  createdAt    DateTime @default(now())

  @@index([personId, createdAt])
}

/// Eltern/Erziehungsberechtigte-Verknüpfung: ein Kind kann mehrere berechtigte
/// Personen haben, eine Person mehrere Kinder (Rechnungsempfänger, Modul 9).
model PersonBeziehung {
  id             String   @id @default(cuid())
  kindId         String
  kind           Person   @relation("Kind", fields: [kindId], references: [id], onDelete: Cascade)
  berechtigterId String
  berechtigter   Person   @relation("Erziehungsberechtigte", fields: [berechtigterId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  @@unique([kindId, berechtigterId])
  @@index([berechtigterId])
}

/// Lehrperson-Qualifikation: unterrichtet Sprache auf Niveau (mehrere möglich).
model Lehrqualifikation {
  id        String  @id @default(cuid())
  personId  String
  person    Person  @relation(fields: [personId], references: [id], onDelete: Cascade)
  spracheId String
  sprache   Sprache @relation(fields: [spracheId], references: [id], onDelete: Cascade)
  niveauId  String
  niveau    Niveau  @relation(fields: [niveauId], references: [id], onDelete: Cascade)

  @@unique([personId, spracheId, niveauId])
}
