// LinguasudApp — Datenbankschema (PostgreSQL)
// Prisma 8 liest dieses Schema als Contract-Quelle: nach jeder Änderung
// `pnpm db:generate` (contract emit) laufen lassen und mit `pnpm db:plan`
// + `pnpm db:migrate` migrieren.
//
// Plan: Modul 3 (Personenverwaltung) führt die Person-Kartei ein; jeder User
// wird dann über User.personId einer Person zugeordnet (E-Mail = Login bleibt
// auf beiden Seiten synchron). Modul 1 hält das Schema bewusst auf das
// Login-/Rechtesystem beschränkt.

datasource db {
  provider = "postgresql"
}

/// Die 5 Rollen des Pflichtenhefts — Mehrfachrollen möglich.
enum Role {
  ADMIN
  CHEF
  BUERO
  LEHRPERSON
  TEILNEHMER
}

model User {
  id                 String    @id @default(cuid())
  email              String    @unique // normalisiert (klein, getrimmt) — = Login
  firstName          String
  lastName           String
  roles              Role[]    @default([])
  /// bcrypt-Hash; null, wenn noch kein Passwort gesetzt wurde (Konto wartet auf Ersteinrichtung per E-Mail-Link).
  passwordHash       String?
  isActive           Boolean   @default(true)
  /// true nach Kontoeinrichtung/Admin-Reset: erzwingt Passwortwechsel nach der nächsten Anmeldung.
  mustChangePassword Boolean   @default(true)
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  /// Verknüpfte Person der Kartei (Modul 3). E-Mail bleibt auf beiden Seiten synchron.
  personId           String?   @unique
  person             Person?   @relation(fields: [personId], references: [id], onDelete: SetNull)

  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  auditLogsAsActor    AuditLog[]
  personNotizen       PersonNotiz[]
  guthabenJournale    GuthabenJournal[]
  zahlungenAlsErfasser Zahlung[]
  honorarAbrechnungenAlsErfasser HonorarAbrechnung[]
  // Modul 13 — Aufgaben, die dieser Stabs-Person zugewiesen sind.
  aufgabenAlsZugewiesene Aufgabe[] @relation("AufgabenAlsZugewiesene")
  // Modul 14 — KI-generierte Lektionspläne.
  kiLektionen KiLektion[] @relation("KiLektionen")

  @@index([isActive])
}

model Session {
  id         String   @id @default(cuid())
  /// SHA-256 des Cookie-Tokens (Base64url). Der Klartext-Token verlässt den Server nur im Cookie.
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  /// Absolute Höchstlaufzeit; zusätzlich gilt ein Idle-Fenster (Verlängerung bei Aktivität).
  expiresAt  DateTime

  @@index([userId])
  @@index([expiresAt])
}

/// Login- und Reset-Versuche für den Brute-Force-Schutz (fensterbasierte Auswertung).
enum AuthEventKind {
  LOGIN
  PASSWORD_RESET
}

model LoginAttempt {
  id        String        @id @default(cuid())
  kind      AuthEventKind @default(LOGIN)
  email     String // normalisiert
  ip        String?
  success   Boolean
  createdAt DateTime      @default(now())

  @@index([kind, email, createdAt])
  @@index([kind, ip, createdAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  /// SHA-256 des Tokens aus dem E-Mail-Link.
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model AuditLog {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  /// Handelnder Account; null für System/Bootstrap. E-Mail zusätzlich als Snapshot.
  actorUserId String?
  actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  actorEmail  String?
  /// Z.B. "user.login", "user.create", "standort.create"
  action      String
  entity      String?
  entityId    String?
  summary     String
  details     Json?
  ip          String?
  userAgent   String?

  @@index([createdAt])
  @@index([actorUserId, createdAt])
  @@index([entity, entityId])
  @@index([action, createdAt])
}

// ————————————————————————————————————————————————————————————————
// Modul 2 — Stammdaten
// Regel (Pflichtenheft): anlegen · aktivieren/deaktivieren ·
// löschen nur wenn unbenutzt · archivieren. Preise jederzeit anpassbar
// (Änderungen laufen über den Audit-Log).
// ————————————————————————————————————————————————————————————————

/// Schlüssel-Wert-Einstellungen (z.B. Seed-Marker, später OpenRouter-Key).
model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Standort der Sprachschule (Hierarchie Standort → Etage → Raum).
model Standort {
  id         String    @id @default(cuid())
  name       String    @unique // z.B. "Vorstadt 18"
  strasse    String
  plz        String
  ort        String
  active     Boolean   @default(true)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  etagen     Etage[]

  @@index([active])
}

model Etage {
  id         String   @id @default(cuid())
  standortId String
  standort   Standort @relation(fields: [standortId], references: [id], onDelete: Cascade)
  /// z.B. "1. Stock"
  name       String
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  raeume     Raum[]

  @@unique([standortId, name])
}

model Raum {
  id         String    @id @default(cuid())
  etageId    String
  etage      Etage     @relation(fields: [etageId], references: [id], onDelete: Cascade)
  /// Raumname, z.B. "Oxford"
  name       String
  /// Sitzplatzzahl
  seats      Int
  active     Boolean   @default(true)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  /// Kurse, die diesen Raum als Standard-Raum führen.
  kurseAlsStandard Kurs[]   @relation("KurseStandardRaum")
  lektionen        Lektion[]
  // Modul 12 — Vermietungs-Termine und -Serien dieses Raums.
  vermietungen     Vermietung[]      @relation("VermietungTermine")
  vermietungSerien VermietungSerie[] @relation("VermietungSerien")

  @@unique([etageId, name])
}

model Sprache {
  id         String    @id @default(cuid())
  name       String    @unique // Deutsch, Englisch, …
  /// Kürzel für Kurscodes, z.B. DE, EN
  code       String    @unique
  active     Boolean   @default(true)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  qualifikationen Lehrqualifikation[]
  kurse           Kurs[] // Sprache dieses Kurses
  // Modul 13 — Einstufungstest-Fragen und Anfragen dieser Sprache.
  einstufungsfragen Einstufungsfrage[]
  anfragen          Anfrage[]
  // Modul 14 — KI-Lektionspläne dieser Sprache.
  kiLektionen       KiLektion[]
}

/// Niveaustufen (A1 … C2), Sortierung frei definierbar.
model Niveau {
  id         String    @id @default(cuid())
  code       String    @unique // A1, A2, B1, …
  name       String? // optionale Bezeichnung
  sortOrder  Int       @default(0)
  active     Boolean   @default(true)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  qualifikationen Lehrqualifikation[]
  kurse           Kurs[] // aktuelles Niveau dieser Kurse
  verlauf         KursNiveauVerlauf[] // Niveau-Abschnitte im Verlauf
  // Modul 13 — Test-Fragen dieses Niveaus sowie gewünschtes/empfohlenes Niveau von Anfragen.
  einstufungsfragen Einstufungsfrage[]
  anfragen          Anfrage[] @relation("AnfragenGewuenschtesNiveau")
  anfragenEmpfohlen Anfrage[] @relation("AnfragenEmpfohlenesNiveau")
  // Modul 14 — KI-Lektionspläne dieses Niveaus.
  kiLektionen       KiLektion[]
}

/// Kursarten: Einzel, 2er, 3er, 4er, 6er, Online, Firmenkurs — beliebig erweiterbar.
model Kursart {
  id         String    @id @default(cuid())
  name       String    @unique
  /// Übliche Teilnehmerzahl; null = individuell (Firmenkurs).
  maxParticipants Int?
  /// Online-Kurse: Raum optional (mal Schulungsraum, mal von zu Hause).
  requiresRoom    Boolean   @default(true)
  sortOrder       Int       @default(0)
  active          Boolean   @default(true)
  archivedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  preise          Preis[]
  kurse           Kurs[]
  honorarSaetze   HonorarSatz[]
  // Modul 14 — KI-Lektionspläne dieser Kursart.
  kiLektionen     KiLektion[]
}

/// Lektionsdauern in Minuten (45, 60, 90, …).
model Lektionsdauer {
  id         String    @id @default(cuid())
  minuten    Int       @unique
  active     Boolean   @default(true)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  preise     Preis[]
}

/// Tarifstufen: Hochtarif = 14 Lektionen/Paket (über Mittag/Abend),
/// Niedertarif = 15 Lektionen/Paket (Vormittag/Nachmittag).
/// Zeitfenster "HH:mm" bestimmen die Standard-Ableitung nach Tageszeit
/// (Modul 5); das Büro kann immer übersteuern.
model Tarifstufe {
  id                String  @id @default(cuid())
  name              String  @unique // "Hochtarif", "Niedertarif"
  lessonsPerPackage Int
  /// Gilt ein Kursstart in diesem Fenster als Hochtarif? (Mittagsfenster von–bis)
  middayFrom        String?
  middayTo          String?
  /// Abendfenster ab (Hochtarif); Vormittag/Nachmittag = Rest des Tages.
  eveningFrom       String?
  active            Boolean   @default(true)
  archivedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  preise            Preis[]
  anmeldungen       Anmeldung[]
}

/// Preisliste: Betrag je Kursart × Lektionsdauer × Tarifstufe — jederzeit anpassbar.
model Preis {
  id             String       @id @default(cuid())
  kursartId      String
  kursart        Kursart      @relation(fields: [kursartId], references: [id], onDelete: Cascade)
  lektionsdauerId String
  lektionsdauer  Lektionsdauer @relation(fields: [lektionsdauerId], references: [id], onDelete: Cascade)
  tarifstufeId   String
  tarifstufe     Tarifstufe   @relation(fields: [tarifstufeId], references: [id], onDelete: Cascade)
  amountChf      Decimal      @db.Decimal(8, 2)

  @@unique([kursartId, lektionsdauerId, tarifstufeId])
}

/// Kostenträger: Firmen und öffentliche Einrichtungen (Rechnungsempfänger).
enum KostentraegerArt {
  FIRMA
  OEFFENTLICHE_EINRICHTUNG
}

model Kostentraeger {
  id            String           @id @default(cuid())
  art           KostentraegerArt
  name          String
  kundennummer  String           @unique
  strasse       String
  plz           String
  ort           String
  active        Boolean          @default(true)
  archivedAt    DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  kurse         Kurs[]
  anmeldungen   Anmeldung[]
  // Modul 9 — Rechnungen an Firma / öffentliche Einrichtung.
  rechnungen    Rechnung[]

  @@index([name])
  @@index([active])
}

// ————————————————————————————————————————————————————————————————
// Modul 3 — Personenverwaltung (Kartei)
// Eine Kartei für alle: Teilnehmende, Interessent/innen, Lehrpersonen,
// Kinder, Büro-/Schulpersonal. Status-Laufbahn laut Pflichtenheft:
// Interessent/in → aktiv → inaktiv («Interessent» wird bei der Anmeldung,
// Modul 5, weiterverwendet).
// ————————————————————————————————————————————————————————————————

/// Lebenszyklus einer Person in der Kartei.
enum PersonStatus {
  INTERESSENT
  AKTIV
  INAKTIV
}

/// Anrede/Geschlecht — zwingend laut Pflichtenheft (Herr/Frau/divers).
enum Anrede {
  HERR
  FRAU
  DIVERS
}

model Person {
  id        String       @id @default(cuid())
  status    PersonStatus @default(INTERESSENT)
  anrede    Anrede
  vorname   String
  nachname  String
  /// Kontakt-E-Mail; bei verknüpftem Konto synchron mit User.email (= Login).
  email     String?
  strasse   String?
  plz       String?
  ort       String?
  /// Abweichende Rechnungsadresse (Modul 9); komplett leer = Postadresse gilt auch für Rechnungen.
  rechnungStrasse String?
  rechnungPlz     String?
  rechnungOrt     String?

  /// Zwei Telefonnummern mit Messenger-Flags.
  telefon1  String?
  whatsapp1 Boolean   @default(false)
  signal1   Boolean   @default(false)
  telefon2  String?
  whatsapp2 Boolean   @default(false)
  signal2   Boolean   @default(false)

  /// Lehrperson-Führung: eindeutiges Kürzel (automatisch aus Vor-/Nachname,
  /// Suffix bei Doppelung) + Qualifikationen Sprache × Niveau.
  istLehrperson Boolean @default(false)
  kuerzel       String? @unique

  /// Verknüpftes Login-Konto (null = noch kein Konto).
  user User?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notizen         PersonNotiz[]
  elternLinks     PersonBeziehung[] @relation("Kind") // diese Person ist das Kind
  kinderLinks     PersonBeziehung[] @relation("Erziehungsberechtigte") // diese Person ist Elternteil
  qualifikationen Lehrqualifikation[]
  // Modul 8 — Dienst- & Urlaubsplanung (nur Personen mit BUERO/ADMIN/CHEF-Konto).
  bueroDienste          BueroDienst[]
  bueroAbweichungen     BueroAbweichung[]
  bueroAbwesenheiten    BueroAbwesenheit[]
  bueroUrlaubskontingente BueroUrlaubskontingent[]
  kurseAlsLehrperson Kurs[]            @relation("KurseAlsLehrperson")
  lektionenAlsLehrperson Lektion[]     @relation("LektionenAlsLehrperson")
  // Modul 11 — Honorarabrechnung (Abweichungen von der Honorar-Matrix).
  honorarSaetze          HonorarSatz[]        @relation("HonorarSaetzeAlsLehrperson")
  honorarAbrechnungen    HonorarAbrechnung[]  @relation("HonorarAbrechnungenAlsLehrperson")
  anmeldungen     Anmeldung[]
  anmeldungenAlsRechnungsempfaenger Anmeldung[] @relation("AnmeldungRechnungsempfaenger")
  // Modul 9 — Rechnungen an diese Person (privat / Eltern als Empfänger).
  rechnungen      Rechnung[] @relation("RechnungenAlsPerson")
  // Modul 10 — Kursbestätigungen dieser Person (Portal: Selbstdrucken).
  bestaetigungen  Kursbestaetigung[] @relation("BestaetigungenAlsPerson")
  // Modul 13 — Anfragen, die dieser Person zugeordnet wurden, und Aufgaben zu dieser Person.
  anfragen        Anfrage[] @relation("AnfragenAlsPerson")
  aufgaben        Aufgabe[] @relation("AufgabenAlsPerson")

  @@index([status])
  @@index([nachname, vorname])
}

/// CRM-Notiz zu einer Person — mit Autor und Datum (Pflichtenheft).
model PersonNotiz {
  id           String   @id @default(cuid())
  personId     String
  person       Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  text         String
  /// Autor-Konto; der Name wird als Snapshot festgehalten, damit Notizen auch
  /// nach Kontolöschung zuordenbar bleiben.
  authorUserId String?
  authorUser   User?    @relation(fields: [authorUserId], references: [id], onDelete: SetNull)
  authorName   String
  createdAt    DateTime @default(now())

  @@index([personId, createdAt])
}

/// Eltern/Erziehungsberechtigte-Verknüpfung: ein Kind kann mehrere berechtigte
/// Personen haben, eine Person mehrere Kinder (Rechnungsempfänger, Modul 9).
model PersonBeziehung {
  id             String   @id @default(cuid())
  kindId         String
  kind           Person   @relation("Kind", fields: [kindId], references: [id], onDelete: Cascade)
  berechtigterId String
  berechtigter   Person   @relation("Erziehungsberechtigte", fields: [berechtigterId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  @@unique([kindId, berechtigterId])
  @@index([berechtigterId])
}

/// Lehrperson-Qualifikation: unterrichtet Sprache auf Niveau (mehrere möglich).
model Lehrqualifikation {
  id        String  @id @default(cuid())
  personId  String
  person    Person  @relation(fields: [personId], references: [id], onDelete: Cascade)
  spracheId String
  sprache   Sprache @relation(fields: [spracheId], references: [id], onDelete: Cascade)
  niveauId  String
  niveau    Niveau  @relation(fields: [niveauId], references: [id], onDelete: Cascade)

  @@unique([personId, spracheId, niveauId])
}

// ————————————————————————————————————————————————————————————————
// Modul 4 — Kurse
// Fortlaufende Kurse ohne Start-/Enddatum (Teilnehmende buchen 14/15-
// Lektionen-Pakete, Modul 5). Automatischer Kurscode aus Sprache/Niveau/
// Kursart/Lehrpersonen-Kürzel + Serial (z.B. DE-B2-6ER-SMIT01-01).
// ————————————————————————————————————————————————————————————————

/// Lebenszyklus eines fortlaufenden Kurses laut Pflichtenheft.
enum KursStatus {
  GEPLANT
  AKTIV
  PAUSIERT
  ABGESCHLOSSEN
  ABGESAGT
}

model Kurs {
  id     String     @id @default(cuid())
  /// Automatischer Kurscode, z.B. DE-B2-6ER-SMIT01-01; Niveau-Wechsel passen ihn an.
  code   String     @unique
  status KursStatus @default(GEPLANT)

  spracheId String
  sprache   Sprache @relation(fields: [spracheId], references: [id], onDelete: Restrict)
  /// Aktuelles Niveau (Spiegel des Niveau-Verlaufs).
  niveauId  String
  niveau    Niveau  @relation(fields: [niveauId], references: [id], onDelete: Restrict)
  kursartId String
  kursart   Kursart @relation(fields: [kursartId], references: [id], onDelete: Restrict)
  /// Lehrperson (Person mit istLehrperson); während des Kurses wechselbar.
  lehrpersonId String?
  lehrperson   Person? @relation("KurseAlsLehrperson", fields: [lehrpersonId], references: [id], onDelete: SetNull)

  /// Wöchentlicher Fixtermin für die rollierende Generierung (Modul 6): 1=Mo … 6=Sa.
  wochentag Int?
  /// Startzeit "HH:mm" (Lokalzeit Europe/Zurich).
  startZeit String?
  dauerMinuten Int?

  /// Kursort: intern mit Standort-Raum, oder extern («Kursort extern» — Firmenkurs vor
  /// Ort im Unternehmen, erscheint nicht im Raumplaner).
  standardRaumId String?
  standardRaum   Raum?   @relation("KurseStandardRaum", fields: [standardRaumId], references: [id], onDelete: SetNull)
  extern         Boolean @default(false)
  externOrt      String?

  /// Teilnehmende-Obergrenze; null = Üblicher Wert der Kursart gilt.
  maxParticipants Int?
  /// Firmenbezug (Rechnungshinweis für Modul 9); null = kein Kostenträger am Kurs.
  kostentraegerId String?
  kostentraeger   Kostentraeger? @relation(fields: [kostentraegerId], references: [id], onDelete: SetNull)

  notizen   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  niveauVerlauf    KursNiveauVerlauf[]
  unterbrechungen  KursUnterbrechung[]
  anmeldungen      Anmeldung[]
  lektionen        Lektion[]
  // Modul 10 — Kursbestätigungen für Niveau-Abschnitte dieses Kurses.
  bestaetigungen   Kursbestaetigung[]
  // Modul 13 — Aufgaben zu diesem Kurs.
  aufgaben         Aufgabe[] @relation("AufgabenAlsKurs")

  @@index([status])
  @@index([lehrpersonId])
  @@index([spracheId, niveauId])
}

/// Niveau-Abschnitt: der Kurs durchläuft Niveaus als Zeiträume. Ein Wechsel
/// (meist von der Lehrperson gemeldet) beendet den laufenden Abschnitt,
/// eröffnet den nächsten und passt den Kurscode an.
model KursNiveauVerlauf {
  id      String @id @default(cuid())
  kursId  String
  kurs    Kurs   @relation(fields: [kursId], references: [id], onDelete: Cascade)
  niveauId String
  niveau  Niveau @relation(fields: [niveauId], references: [id], onDelete: Restrict)
  /// Abschnittsbeginn (Datum, UTC-Mitternacht des Lokal-Tags).
  von     DateTime
  /// Abschnittsende (null = laufender Abschnitt); wird beim Wechsel gesetzt.
  bis     DateTime?
  /// true, wenn die Lehrperson den Wechsel gemeldet hat (Auslöser Kursbestätigung, Modul 10).
  gemeldetVonLehrperson Boolean @default(false)
  createdAt DateTime @default(now())

  // Modul 10 — Bestätigungen für diesen abgeschlossenen Abschnitt.
  bestaetigungen Kursbestaetigung[]

  @@index([kursId, von])
}

/// Unterbrechung eines Kurses (Zeitraum, inklusive): im Planer ausgegraut
/// sichtbar, der Slot bleibt für andere Kurse überbuchbar.
model KursUnterbrechung {
  id      String @id @default(cuid())
  kursId  String
  kurs    Kurs   @relation(fields: [kursId], references: [id], onDelete: Cascade)
  von     DateTime
  bis     DateTime
  grund   String?
  /// true, wenn die Lehrperson die Unterbrechung gemeldet hat.
  gemeldetVonLehrperson Boolean @default(false)
  createdAt DateTime @default(now())

  @@index([kursId, von])
}

// ————————————————————————————————————————————————————————————————
// Modul 5 — Anmeldungen
// Drei Billing-Typen, Probelektionen, Tarif/Paketgrösse/Preis übersteuerbar,
// Lektionsguthaben als Konto mit Journal, Paketende-Automatik, Fehlzeiten.
// ————————————————————————————————————————————————————————————————

enum BillingTyp {
  PRIVAT
  FIRMA
  OEFFENTLICHE_EINRICHTUNG
}

/// Anmeldung-Lebenszyklus: Probe wandelt sich bei fester Anmeldung zu aktiv.
enum AnmeldungStatus {
  PROBE
  AKTIV
  BEENDET
}

/// Entscheid der Teilnehmenden am Paketende (Automatik nach 12./13. Lektion).
enum PaketEntscheid {
  OFFEN
  VERLAENGERT
  BEENDET
}

model Anmeldung {
  id       String          @id @default(cuid())
  kursId   String
  kurs     Kurs            @relation(fields: [kursId], references: [id], onDelete: Cascade)
  personId String
  person   Person          @relation(fields: [personId], references: [id], onDelete: Restrict)
  status   AnmeldungStatus @default(PROBE)

  /// Rechnungsweg laut Pflichtenheft: privat selbstzahlend, Firma bzw.
  /// öffentliche Einrichtung über den Kostenträger.
  billingTyp      BillingTyp @default(PRIVAT)
  kostentraegerId String?
  kostentraeger   Kostentraeger? @relation(fields: [kostentraegerId], references: [id], onDelete: SetNull)
  /// Abweichender Rechnungsempfänger (z.B. Eltern eines Kindes, Modul 9).
  rechnungsempfaengerId String?
  rechnungsempfaenger   Person?  @relation("AnmeldungRechnungsempfaenger", fields: [rechnungsempfaengerId], references: [id], onDelete: SetNull)

  /// Angewandte Tarifstufe; tarifUebersteuert = Büro übersteuert die
  /// automatische Tageszeit-Ableitung.
  tarifstufeId String
  tarifstufe   Tarifstufe @relation(fields: [tarifstufeId], references: [id], onDelete: Restrict)
  tarifUebersteuert Boolean @default(false)
  /// Paketgrösse in Lektionen (Standard 14/15 aus der Tarifstufe, übersteuerbar).
  paketGroesse Int
  paketGroesseUebersteuert Boolean @default(false)
  /// Paketpreis CHF (Preisliste Kursart×Dauer×Stufe, übersteuerbar).
  preisChf Decimal @db.Decimal(8, 2)
  preisUebersteuert Boolean @default(false)
  /// Dokumentierte Abweichung vom Preislistenpreis (Pflicht bei Übersteuerung).
  preisAbweichungGrund String?

  /// Laufendes Paket seit (UTC-Instant); Lektionen werden über das Journal gezählt.
  paketStartAt DateTime @default(now())
  /// Zustand der Paketende-Automatik.
  paketEntscheid       PaketEntscheid @default(OFFEN)
  paketEndeGemeldetAt  DateTime?

  notizen   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  journal GuthabenJournal[]
  anwesenheiten Anwesenheit[]
  // Modul 9 — Rechnungen, die aus Paket-Verlängerungen dieser Anmeldung ausgelöst wurden.
  rechnungen Rechnung[]
  // Modul 10 — Kursbestätigungen, die aus dieser Anmeldung entstanden sind.
  bestaetigungen Kursbestaetigung[]

  @@index([kursId, status])
  @@index([personId])
  @@index([status, paketEntscheid])
}

/// Journal-Art des Lektionsguthabens.
enum JournalArt {
  /// Paketaufladung (+Paketgrösse).
  AUFLADUNG
  /// Durchgeführte Lektion (−1).
  VERBRAUCH
  /// Unentschuldigte Fehlzeit (−1).
  FEHLZEIT_UNENTSCHULDIGT
  /// Entschuldigte Fehlzeit (−0, Dokumentationseintrag).
  FEHLZEIT_ENTSCHULDIGT
  /// Manuelle Korrektur durchs Büro (±n).
  KORREKTUR
}

/// Lektionsguthaben als Konto: der Stand ist die Summe der Journal-Deltas.
/// Verbrauchsbuchungen kommen mit Modul 7 (Anwesenheit); hier liegen auch die
/// manuellen Büro-Korrekturen und die Paket-Aufladungen.
model GuthabenJournal {
  id          String     @id @default(cuid())
  anmeldungId String
  anmeldung   Anmeldung  @relation(fields: [anmeldungId], references: [id], onDelete: Cascade)
  art         JournalArt
  /// +n (Aufladung), −1 (Verbrauch/unentschuldigt), 0 (entschuldigt), ±n (Korrektur).
  delta       Int
  datum       DateTime   @default(now())
  /// Verknüpfte Lektion (Verbrauch/Fehlzeit), sobald Modul 7 die Anwesenheit abschliesst.
  lektionId   String?
  lektion     Lektion?   @relation(fields: [lektionId], references: [id], onDelete: SetNull)
  bemerkung   String?
  /// Erfasst durch (Büro); Name als Snapshot.
  actorUserId String?
  actorUser   User?      @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  actorName   String
  createdAt   DateTime   @default(now())

  @@index([anmeldungId, datum])
}

// ————————————————————————————————————————————————————————————————
// Modul 6 — Lektionsgenerierung & Raumplaner
// Rollierende Generierung 2 Wochen im Voraus (nächtlicher Job); Planer
// zeigt Standort → Etage → Räume, Verschieben/Fixieren nur durchs Büro,
// keine harte Konfliktblockade.
// ————————————————————————————————————————————————————————————————

enum LektionStatus {
  /// Automatisch generiert, wartet auf Fixierung durchs Büro.
  PROVISORISCH
  /// Vom Büro fixiert (Zeit/Raum bindend; bei Änderung werden Teilnehmende informiert).
  FIXIERT
  ABGESAGT
  /// Anwesenheit vollständig erfasst und abgeschlossen — Guthaben gebucht
  /// (Modul 7); nur diese Lektionen zählen später für Honorare (Modul 11).
  DURCHGEFUEHRT
}

model Lektion {
  id     String @id @default(cuid())
  kursId String
  kurs   Kurs   @relation(fields: [kursId], references: [id], onDelete: Cascade)
  /// Lehrperson zum Termin (Snapshot; unabhängig von späteren Kurswechseln).
  lehrpersonId String?
  lehrperson   Person? @relation("LektionenAlsLehrperson", fields: [lehrpersonId], references: [id], onDelete: SetNull)
  /// Termin (UTC-Instant, Konvertierung via src/lib/zeit.ts).
  startAt      DateTime
  dauerMinuten Int
  /// Raum; null = Online ohne Schulungsraum (externer Firmenkurs erscheint gar nicht im Planer).
  raumId String?
  raum   Raum?   @relation(fields: [raumId], references: [id], onDelete: SetNull)
  status LektionStatus @default(PROVISORISCH)
  /// "GENERIERT" (nächtlicher Job) oder "MANUELL" (Büro).
  quelle String @default("GENERIERT")
  notiz  String?
  fixiertAt DateTime?
  /// Zeitpunkt des Anwesenheits-Abschlusses (Status DURCHGEFUEHRT, Modul 7).
  abgeschlossenAt DateTime?
  /// Erinnerung an die Lehrperson wegen offener Anwesenheit versendet (Modul 7, nächster Tag).
  anwesenheitErinnertAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  journal GuthabenJournal[]
  anwesenheiten Anwesenheit[]

  @@index([kursId, startAt])
  @@index([startAt])
}

// ————————————————————————————————————————————————————————————————
// Modul 7 — Anwesenheitskontrolle
// Erfassung direkt nach der Lektion (Lehrperson 24 h, danach Büro),
// Abschluss erst bei vollständiger Erfassung → bucht das Guthaben-
// Journal (anwesend −1, unentschuldigt −1, entschuldigt −0; Probe
// ohne Abbuchung), danach Paketende-Automatik prüfen. Büro korrigiert
// nachträglich (Journal-Eintrag wird angepasst, alles im Audit-Log).
// ————————————————————————————————————————————————————————————————

/// Anwesenheit einer Anmeldung in einer Lektion. Abwesend ohne Büro-
/// Entscheid gilt bis zur Korrektur als unentschuldigt (−1).
enum AnwesenheitStatus {
  ANWESEND
  ABWESEND_ENTSCHULDIGT
  ABWESEND_UNENTSCHULDIGT
}

model Anwesenheit {
  id          String            @id @default(cuid())
  lektionId   String
  lektion     Lektion           @relation(fields: [lektionId], references: [id], onDelete: Cascade)
  anmeldungId String
  anmeldung   Anmeldung         @relation(fields: [anmeldungId], references: [id], onDelete: Cascade)
  status      AnwesenheitStatus
  bemerkung   String?
  /// Name des/der Erfassenden als Snapshot (Lehrperson oder Büro).
  erfasstVonName String
  /// true, wenn die Lehrperson erfasst hat (Büro-Korrekturen überschreiben).
  vonLehrperson Boolean @default(false)
  erfasstAt   DateTime @default(now())
  /// Letzte Korrektur durchs Büro (Journal-Eintrag wurde angepasst).
  korrigiertAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([lektionId, anmeldungId])
  @@index([anmeldungId])
}

// ————————————————————————————————————————————————————————————————
// Modul 8 — Dienst- & Urlaubsplanung Büro
// Nur Personen mit BUERO/ADMIN/CHEF-Konto (Lehrpersonen organisieren sich
// selbst): wiederkehrendes Pensum (beliebig viele Blöcke pro Wochentag,
// mehrere Personen parallel), Tages-Abweichungen, Abwesenheiten
// (Urlaub/Krankheit/sonstige) und ein anpassbares Urlaubs-Jahreskontingent
// (Default 20 Tage; alle im Stundenlohn, kein Genehmigungs-Workflow).
// ————————————————————————————————————————————————————————————————

/// Wiederkehrender Dienst-Block im Büro-Wochenplan (= Pensum): beliebig
/// viele Blöcke pro Wochentag, z.B. 45 Min vor + nach Unterricht.
model BueroDienst {
  id        String   @id @default(cuid())
  personId  String
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  /// 1 = Montag … 7 = Sonntag (ISO-8601, wie src/lib/zeit.ts).
  wochentag Int
  /// "HH:mm" (Lokalzeit Europe/Zurich).
  startZeit String
  endZeit   String
  notiz     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([personId, wochentag])
}

/// Abweichung vom Pensum an einem konkreten Kalendertag: ARBEITSZEIT ersetzt
/// die Pensum-Blöcke des Tages durch eine eigene Zeit; FREI ist dienstfrei
/// ohne Abwesenheits-Art (z.B. Kompensation — zählt nicht aufs Urlaubs-Kontingent).
enum BueroAbweichungArt {
  ARBEITSZEIT
  FREI
}

model BueroAbweichung {
  id        String            @id @default(cuid())
  personId  String
  person    Person            @relation(fields: [personId], references: [id], onDelete: Cascade)
  /// Kalendertag (UTC-Mitternacht des Lokal-Tags Europe/Zurich).
  datum     DateTime
  art       BueroAbweichungArt
  /// Bei ARBEITSZEIT: "HH:mm" (Start < Ende); bei FREI null.
  startZeit String?
  endZeit   String?
  notiz     String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  /// Pro Tag und Person genau eine Abweichung (Ansicht ist dann eindeutig).
  @@unique([personId, datum])
  @@index([datum])
}

/// Abwesenheits-Arten laut Pflichtenheft: Urlaub (zählt aufs Kontingent),
/// Krankheit, sonstige.
enum BueroAbwesenheitArt {
  URLAUB
  KRANKHEIT
  SONSTIGE
}

model BueroAbwesenheit {
  id        String             @id @default(cuid())
  personId  String
  person    Person             @relation(fields: [personId], references: [id], onDelete: Cascade)
  art       BueroAbwesenheitArt
  /// Von/Bis inklusive (UTC-Mitternacht des Lokal-Tags, Muster dbDatum()).
  von       DateTime
  bis       DateTime
  bemerkung String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([personId, von])
  @@index([von, bis])
}

/// Anpassbares Urlaubs-Jahreskontingent (Tage) pro Person; ohne Eintrag gilt
/// der Default (BUERO_URLAUB_DEFAULT_TAGE, 20). Genutzte Tage zählt die pure
/// Logik in src/lib/bueroplan/logik.ts aus den URLAUB-Abwesenheiten.
model BueroUrlaubskontingent {
  id       String @id @default(cuid())
  personId String
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)
  jahr     Int
  tage     Int

  @@unique([personId, jahr])
}

// ————————————————————————————————————————————————————————————————
// Modul 9 — Rechnungen (Schweizer QR-Rechnung)
// Empfänger: Person (auch Eltern als abweichender Empfänger) oder Kostenträger
// (Firma / öffentliche Einrichtung). Mehrere Positionen, MwSt-Feld,
// Teilzahlungen, Mahn-Stufen. Status-Laufbahn: Entwurf → versendet →
// (teilbezahlt) → bezahlt → storniert; «überfällig» ist abgeleitet
// (versendet/teilbezahlt und Fälligkeit verstrichen) und wird nicht gespeichert.
// ————————————————————————————————————————————————————————————————

/// Rechnungs-Lebenszyklus laut Pflichtenheft.
enum RechnungStatus {
  ENTWURF
  VERSENDET
  TEILBEZAHLT
  BEZAHLT
  STORNIERT
}

model Rechnung {
  id     String         @id @default(cuid())
  /// Fortlaufende Rechnungsnummer "RE-2026-0123" (Zähler in SystemSetting).
  nummer String         @unique
  status RechnungStatus @default(ENTWURF)

  /// Empfänger: entweder Person (privat, inkl. Eltern als abweichender
  /// Empfänger) oder Kostenträger (Firma / öffentliche Einrichtung).
  personId        String?
  person          Person?        @relation("RechnungenAlsPerson", fields: [personId], references: [id], onDelete: Restrict)
  kostentraegerId String?
  kostentraeger   Kostentraeger? @relation(fields: [kostentraegerId], references: [id], onDelete: Restrict)
  // Modul 12 — Mieter als dritter Empfänger-Typ (Raumvermietung); die
  // Rechnung entsteht ausschliesslich aus der Vermietung (Vermietung.rechnungId).
  mieterId        String?
  mieter          VermietungMieter? @relation(fields: [mieterId], references: [id], onDelete: Restrict)
  /// Raumvermietung, aus der diese Rechnung stammt (Modul 12); null = reguläre Rechnung.
  vermietung      Vermietung?
  /// Ursprung: Paket-Anmeldung, deren Verlängerung die Rechnung auslöste.
  anmeldungId String?
  anmeldung   Anmeldung? @relation(fields: [anmeldungId], references: [id], onDelete: SetNull)

  /// Empfänger-Adresse als Snapshot (Person mit abweichender
  /// Rechnungsadresse: rechnungStrasse/rechnungPlz/rechnungOrt).
  empfaengerName    String
  empfaengerStrasse String
  empfaengerPlz     String
  empfaengerOrt     String
  empfaengerLand    String  @default("CH")
  empfaengerEmail   String?

  /// Positionen exklusive MwSt; mwstSatzProzent null = MwSt-frei («falls relevant»).
  betragChf       Decimal @db.Decimal(10, 2)
  mwstSatzProzent Decimal? @db.Decimal(5, 2)
  totalChf        Decimal @db.Decimal(10, 2)

  /// Rechnungsdatum; Fälligkeit = UTC-Mitternacht des Lokal-Tags (Muster dbDatum()).
  rechnungsdatum DateTime
  faelligAm      DateTime
  versendetAt    DateTime?
  storniertAt    DateTime?
  storniertGrund String?

  /// Höchste versendete Mahn-Stufe (0 = keine; 1 = freundliche Erinnerung,
  /// 2 = Mahnung). Der Mahn-Job versendet jede Stufe genau einmal.
  mahnStufe    Int       @default(0)
  letzteMahnAt DateTime?

  /// 27-stellige QR-Referenznummer (mod-10-rekursiv geprüft) für den QR-Zahlteil.
  referenzNr String @unique
  notiz      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  positionen RechnungsPosition[]
  zahlungen  Zahlung[]
  mahnungen  Mahnung[]

  @@index([status, faelligAm])
  @@index([personId])
  @@index([kostentraegerId])
  @@index([mieterId])
}

/// Rechnungs-Position (Paket, Lehrmittel, Registration …); Beträge exklusive MwSt.
model RechnungsPosition {
  id         String   @id @default(cuid())
  rechnungId String
  rechnung   Rechnung @relation(fields: [rechnungId], references: [id], onDelete: Cascade)
  text       String
  menge      Int      @default(1)
  einzelpreisChf Decimal @db.Decimal(10, 2)
  reihenfolge Int     @default(0)
  createdAt  DateTime @default(now())

  @@index([rechnungId])
}

/// Teil- oder Vollzahlung zu einer Rechnung; der Restbetrag ergibt sich
/// aus total − Summe Zahlungen (pure Logik, src/lib/rechnungen/logik.ts).
model Zahlung {
  id         String   @id @default(cuid())
  rechnungId String
  rechnung   Rechnung @relation(fields: [rechnungId], references: [id], onDelete: Cascade)
  betragChf  Decimal  @db.Decimal(10, 2)
  /// Eingangsdatum (UTC-Instant; Anzeige als Datum).
  datum      DateTime @default(now())
  bemerkung  String?
  actorUserId String?
  actorUser   User?   @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  actorName   String
  createdAt  DateTime @default(now())

  @@index([rechnungId])
}

/// Versendete Mahnung (Stufe 1 = freundliche Erinnerung, Stufe 2 = Mahnung).
model Mahnung {
  id         String   @id @default(cuid())
  rechnungId String
  rechnung   Rechnung @relation(fields: [rechnungId], references: [id], onDelete: Cascade)
  stufe      Int
  versendetAt DateTime @default(now())
  email      String
  /// Versand-Ergebnis: null = geliefert, sonst Grund (z.B. Dev-Log).
  fehler     String?
  createdAt  DateTime @default(now())

  @@index([rechnungId])
}

// ————————————————————————————————————————————————————————————————
// Modul 10 — Kursbestätigungen (PDF)
// Auslöser: Niveau-Wechsel (Modul 4) beendet einen Abschnitt → das System
// erzeugt automatisch die Bestätigung für alle aktiven Teilnehmenden; das
// Büro kann jederzeit manuell erzeugen (auch für beendete Anmeldungen und
// den laufenden Abschnitt). Inhalt nur Deutsch, keine Leistungsbewertung;
// bereit im Teilnehmer-Portal zum Selbstdrucken.
// ————————————————————————————————————————————————————————————————

/// Was die Erzeugung ausgelöst hat (Audit/Anzeige).
enum BestaetigungsAusloeser {
  /// Niveau-Wechsel hat den Abschnitt geschlossen (automatisch).
  NIVEAU_WECHSEL
  /// Durchs Büro manuell ausgelöst (inkl. Aktualisierung).
  MANUELL
}

model Kursbestaetigung {
  id String @id @default(cuid())

  /// Teilnehmende Person (Empfänger der Bestätigung).
  personId String
  person   Person @relation("BestaetigungenAlsPerson", fields: [personId], references: [id], onDelete: Restrict)
  kursId   String
  kurs     Kurs   @relation(fields: [kursId], references: [id], onDelete: Cascade)
  /// Bestätigter Niveau-Abschnitt (Zeitraum dieses Abschnitts).
  verlaufId String
  verlauf   KursNiveauVerlauf @relation(fields: [verlaufId], references: [id], onDelete: Cascade)
  /// Ursprungs-Anmeldung (Snapshot-Link; wird beim Löschen der Anmeldung frei gegeben).
  anmeldungId String?
  anmeldung   Anmeldung? @relation(fields: [anmeldungId], references: [id], onDelete: SetNull)

  // ——— Snapshots: das PDF bleibt stabil, auch wenn Stammdaten sich ändern ———
  /// Anrede der Person (Wert der Anrede-Enumeration: HERR/FRAU/DIVERS).
  personAnrede String
  /// Voller Name zum Zeitpunkt der Ausstellung.
  personName   String
  spracheName  String
  niveauCode   String
  /// Optionale Niveau-Bezeichnung (z.B. «obere Mittelstufe»).
  niveauName   String?
  kursartName  String
  /// Kurscode zum Zeitpunkt der Ausstellung.
  kursCode     String
  /// Zeitraum des Abschnitts (UTC-Mitternacht des Lokal-Tags, Muster dbDatum());
  /// bei Ausstellung im laufenden Abschnitt ist bis = Ausstellungsdatum.
  zeitraumVon  DateTime
  zeitraumBis  DateTime
  /// Besuchte Lektionen: Anwesenheit ANWESEND in DURCHGEFUEHRTen Lektionen
  /// des Kurses mit startAt im Abschnitts-Zeitraum (snapshot bei Erzeugung).
  besuchteLektionen Int
  /// Ausstellungsdatum (UTC-Mitternacht des Lokal-Tags).
  ausstellungsdatum DateTime
  /// Name des Auslösenden als Snapshot.
  ausgestelltVonName String
  ausloeser  BestaetigungsAusloeser

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Pro Person und Niveau-Abschnitt genau eine Bestätigung (Erneuerung = Update).
  @@unique([personId, verlaufId])
  @@index([personId, ausstellungsdatum])
  @@index([kursId])
}

// ————————————————————————————————————————————————————————————————
// Modul 11 — Honorarabrechnung
// Nur DURCHGEFÜHRTE Lektionen zählen (Modul 7); Abwesenheiten von
// Teilnehmenden zählen normal (die Lektion fand statt). Honorar-Matrix
// Lehrperson × Kursart × Lektionsdauer mit globalem Default-Stundensatz
// (SystemSetting «honorar.defaultStundensatz») als Vorbelegung — der
// Betrag je Lektion wird aus dem Stundensatz hochgerechnet (Minuten/60)
// und auf 5 Rappen gerundet.
// ————————————————————————————————————————————————————————————————

/// Honorar-Satz der Matrix: Stundensatz (CHF/h) einer Lehrperson je
/// Kursart und Lektionsdauer (Minuten). Ohne Eintrag gilt der globale
/// Default-Stundensatz; Dauer wird hochgerechnet (Stundensatz × Min/60).
model HonorarSatz {
  id           String  @id @default(cuid())
  lehrpersonId String
  lehrperson   Person  @relation("HonorarSaetzeAlsLehrperson", fields: [lehrpersonId], references: [id], onDelete: Cascade)
  kursartId    String
  kursart      Kursart @relation(fields: [kursartId], references: [id], onDelete: Cascade)
  /// Lektionsdauer in Minuten (Wert der Stammdaten «Lektionsdauer»).
  minuten        Int
  /// Stundensatz CHF (Beträge als String mit 2 Nachkommastellen).
  stundensatzChf Decimal @db.Decimal(8, 2)

  @@unique([lehrpersonId, kursartId, minuten])
  @@index([lehrpersonId])
}

/// Status-Tracking pro Lehrperson und Monat («als bezahlt markieren»).
model HonorarAbrechnung {
  id           String @id @default(cuid())
  lehrpersonId String
  lehrperson   Person @relation("HonorarAbrechnungenAlsLehrperson", fields: [lehrpersonId], references: [id], onDelete: Cascade)
  /// Monat als "YYYY-MM" (Lokal-Tage Europe/Zurich der Lektionen).
  monat        String
  status       HonorarStatus @default(OFFEN)

  /// Snapshots beim Markieren (die Lektionsliste selbst bleibt live rechenbar).
  lektionenAnzahl Int
  totalChf        Decimal @db.Decimal(10, 2)

  bezahltAt  DateTime?
  actorUserId String?
  actorUser   User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  actorName   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([lehrpersonId, monat])
  @@index([monat])
}

enum HonorarStatus {
  OFFEN
  BEZAHLT
}

// ————————————————————————————————————————————————————————————————
// Modul 12 — Raumvermietung
// Eigene Mieterkartei (Name, Kontakt, Rechnungsadresse); einmalige
// Vermietungen + Serien, die sich beim Anlegen direkt in konkrete
// Vermietungs-Termine materialisieren (einzeln absagbar/löschbar).
// Abrechnung über Modul 9: Rechnungs-Entwurf mit Empfänger = Mieter
// (Rechnung.mieterId als dritter Empfänger-Typ — Mieter sind bewusst
// KEINE Kostenträger, die Pflichtenheft-semantisch für Firmen und
// öffentliche Einrichtungen im Kurs-/Anmelde-Billing stehen). Planer:
// Belegungsblöcke deutlich gekennzeichnet, abgesagt = ausgegraut.
// Status: geplant → findet statt · abgesagt.
// ————————————————————————————————————————————————————————————————

/// Lebenszyklus einer Vermietung laut Pflichtenheft.
enum VermietungStatus {
  GEPLANT
  FINDET_STATT
  ABGESAGT
}

/// Mieter der Mieterkartei (Modul 12): Name, Kontakt und Rechnungsadresse
/// (Basis des Empfänger-Snapshots der Vermietungs-Rechnung, Modul 9).
model VermietungMieter {
  id        String    @id @default(cuid())
  name      String
  /// Kontakt (E-Mail = Versandadresse der Rechnung, Telefon optional).
  email     String?
  telefon   String?
  /// Rechnungsadresse (Pflicht — der Empfänger-Snapshot der Rechnung braucht sie).
  strasse   String
  plz       String
  ort       String
  notiz     String?
  active    Boolean   @default(true)
  archivedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  serien       VermietungSerie[]
  vermietungen Vermietung[]
  rechnungen   Rechnung[]

  @@index([name])
  @@index([active])
}

/// Vermietungs-Serie (z.B. jeden Dienstag 18–20 Uhr, 1.1.–31.12.): wird beim
/// Anlegen in konkrete Vermietungs-Termine materialisiert, die einzeln
/// absagbar/löschbar sind. Beim Löschen der Serie bleiben Termine mit Status
/// «findet statt», Absage oder Rechnung bestehen (serieId → null).
model VermietungSerie {
  id        String @id @default(cuid())
  mieterId  String
  mieter    VermietungMieter @relation(fields: [mieterId], references: [id], onDelete: Restrict)
  raumId    String
  raum      Raum   @relation("VermietungSerien", fields: [raumId], references: [id], onDelete: Restrict)
  /// 1 = Montag … 6 = Samstag (Planer-Raster Mo–Sa, kein Sonntag).
  wochentag Int
  /// Zeitfenster "HH:mm" (Lokalzeit Europe/Zurich, 06:30–23:00).
  startZeit String
  endZeit   String
  /// Von/Bis inklusive (UTC-Mitternacht des Lokal-Tags, Muster dbDatum()).
  von       DateTime
  bis       DateTime
  /// Preis pro Termin CHF (frei vergeben — keine Preisliste).
  preisChf  Decimal @db.Decimal(10, 2)
  notiz     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  termine Vermietung[]

  @@index([mieterId])
  @@index([von])
}

/// Konkreter Vermietungs-Termin (Einzelvermietung oder materialisierter
/// Serientermin). Keine harte Konfliktblockade — Doppelbelegungen markiert
/// der Planer farblich; abgesagte Termine sind überbuchbar.
model Vermietung {
  id           String @id @default(cuid())
  mieterId     String
  mieter       VermietungMieter @relation(fields: [mieterId], references: [id], onDelete: Restrict)
  raumId       String
  raum         Raum   @relation("VermietungTermine", fields: [raumId], references: [id], onDelete: Restrict)
  /// Termin (UTC-Instant, Konvertierung via src/lib/zeit.ts).
  startAt      DateTime
  dauerMinuten Int
  /// Preis CHF (frei vergeben — laut Pflichtenheft genügt ein freier Preis).
  preisChf     Decimal @db.Decimal(10, 2)
  status       VermietungStatus @default(GEPLANT)
  absageGrund  String?
  notiz        String?
  /// Ursprungs-Serie; null bei Einzelvermietungen.
  serieId      String?
  serie        VermietungSerie? @relation(fields: [serieId], references: [id], onDelete: SetNull)
  /// Rechnungs-Entwurf aus Modul 9 (eine Rechnung pro Termin); beim Löschen
  /// des Entwurfs wird die Verknüpfung frei (Verkaufsdokument bleibt).
  rechnungId   String? @unique
  rechnung     Rechnung? @relation(fields: [rechnungId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([raumId, startAt])
  @@index([mieterId])
  @@index([startAt])
  @@index([serieId])
}

// ————————————————————————————————————————————————————————————————
// Modul 13 — Aufgaben & Anfragen
// Öffentlicher Online-Einstufungstest (Multiple Choice, automatische
// Niveau-Empfehlung), Anfrage-Eingang mit Bestätigungs-/Büro-Mail und
// automatisch angelegter Büro-Aufgabe; schlichtes Aufgaben-System mit
// optionalen Verknüpfungen zu Person/Kurs/Anfrage. Automatik-Aufgaben
// sind über dedupKey (unique) gegen Doppel-Anlage pro Vorgang gesichert.
// ————————————————————————————————————————————————————————————————

/// Frage des Online-Einstufungstests: Multiple Choice mit 4 Antwortoptionen,
/// je Sprache und Niveau; die Auswertung (pure Logik, src/lib/anfragen/logik.ts)
/// leitet daraus die Niveau-Empfehlung ab. Pflegbar nur Admin (Stammdaten).
model Einstufungsfrage {
  id        String    @id @default(cuid())
  spracheId String
  sprache   Sprache   @relation(fields: [spracheId], references: [id], onDelete: Restrict)
  niveauId  String
  niveau    Niveau    @relation(fields: [niveauId], references: [id], onDelete: Restrict)
  /// Fragetext
  text      String
  /// Antwortoptionen (4 feste Optionen; Option «richtig» ist die korrekte).
  antwort1  String
  antwort2  String
  antwort3  String
  antwort4  String
  /// Index der richtigen Antwort (1–4).
  richtig   Int
  /// Reihenfolge innerhalb Sprache × Niveau.
  sortOrder Int       @default(0)
  active    Boolean   @default(true)
  archivedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([spracheId, niveauId, sortOrder])
  @@index([active])
}

/// Status-Laufbahn einer Anfrage aus dem öffentlichen Formular.
enum AnfrageStatus {
  OFFEN
  IN_BEARBEITUNG
  /// Person zugeordnet (nach Identitätsprüfung, Modul 13).
  ZUGEORDNET
  ABGELEHNT
}

model Anfrage {
  id     String        @id @default(cuid())
  status AnfrageStatus @default(OFFEN)

  /// Kontakt-Snapshot vom Formular (bewusst Freitext-Kopie — die Person ist
  /// erst nach der Identitätsprüfung verknüpft).
  name      String
  email     String
  telefon   String?
  nachricht String?

  /// Gewünschte Sprache/Niveau + Niveau-Empfehlung aus dem Einstufungstest.
  spracheId String?
  sprache   Sprache? @relation(fields: [spracheId], references: [id], onDelete: SetNull)
  niveauId  String?
  niveau    Niveau?  @relation("AnfragenGewuenschtesNiveau", fields: [niveauId], references: [id], onDelete: SetNull)
  empfohlenesNiveauId String?
  empfohlenesNiveau   Niveau?  @relation("AnfragenEmpfohlenesNiveau", fields: [empfohlenesNiveauId], references: [id], onDelete: SetNull)
  /// Roh-Auswertung des Tests (Json: pro Niveau richtig/total), null ohne Test.
  testResultat Json?

  /// Zuordnung nach Identitätsprüfung: bestehende Person oder neue
  /// INTERESSENT-Person; sonst bleibt die Anfrage anonym stehen.
  personId  String?
  person    Person? @relation("AnfragenAlsPerson", fields: [personId], references: [id], onDelete: SetNull)
  zugeordnetAt     DateTime?
  zugeordnetVonName String?
  /// Begründung bei Ablehnung (optional dokumentiert).
  ablehnungsGrund  String?

  /// Bestätigungs-Mail an die Anfragenden (Versand-Resultat dokumentiert).
  bestaetigtAm  DateTime?
  bestaetigtVia String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  aufgaben Aufgabe[]

  @@index([status, createdAt])
  @@index([email])
  @@index([personId])
}

/// Status einer Aufgabe: schlicht offen/erledigt (Pflichtenheft — weitere
/// Stati nur wenn sinnvoll, hier bewusst weggelassen).
enum AufgabeStatus {
  OFFEN
  ERLEDIGT
}

model Aufgabe {
  id          String        @id @default(cuid())
  titel       String
  beschreibung String?
  status      AufgabeStatus @default(OFFEN)
  /// Zugewiesene:r (Stabs-Konto; null = unbeauftragt, freigeben fürs Büro).
  assigneeUserId String?
  assignee       User?   @relation("AufgabenAlsZugewiesene", fields: [assigneeUserId], references: [id], onDelete: SetNull)
  /// Fälligkeit (UTC-Mitternacht des Lokal-Tags, Muster dbDatum()).
  faelligAm   DateTime?
  erledigtAt  DateTime?
  erledigtVonName String?

  /// Optionale Verknüpfungen (nullable FKs).
  personId  String?
  person    Person?  @relation("AufgabenAlsPerson", fields: [personId], references: [id], onDelete: SetNull)
  kursId    String?
  kurs      Kurs?    @relation("AufgabenAlsKurs", fields: [kursId], references: [id], onDelete: SetNull)
  anfrageId String?
  anfrage   Anfrage? @relation(fields: [anfrageId], references: [id], onDelete: Cascade)

  /// Quelle: "manual" | "anfrage" | "paketende" | "anwesenheit".
  quelle String @default("manual")
  /// Dedup-Marker der Automatik (z.B. "anfrage:<id>", "paketende:<anmeldungId>",
  /// "anwesenheit:<lektionId>") — verhindert Doppel-Aufgaben pro Vorgang; beim
  /// Erledigen wird nie neu angelegt (unique über beide Stati).
  dedupKey String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, faelligAm])
  @@index([assigneeUserId, status])
  @@index([anfrageId])
  @@index([personId])
  @@index([kursId])
}

/// Drossel öffentlicher Formulare (Modul 13): fensterbasierte Auswertung pro
/// E-Mail/IP — das gleiche Muster wie der Brute-Force-Schutz (isRateLimited),
/// aber getrennt von den Auth-Ereignissen, da öffentliche Formulare kein
/// Login sind. `form` erlaubt später weitere öffentliche Formulare.
model PublicFormVersuch {
  id        String   @id @default(cuid())
  /// z.B. "anfrage" (Einstufungstest ist rein lesend und braucht keine Drossel).
  form      String
  /// Normalisierte E-Mail (klein, getrimmt); "" bei fehlender Angabe.
  email     String
  ip        String?
  createdAt DateTime @default(now())

  @@index([form, email, createdAt])
  @@index([form, ip, createdAt])
}


// ————————————————————————————————————————————————————————————————
// Modul 14 — KI-Lektionsgenerator
// Feature vollständig sichtbar; die KI-Anbindung (OpenRouter) wird erst
// aktiv, wenn Admin unter Stammdaten → KI-Generator API-Key + Modell
// hinterlegt. Zwei Modi: strukturiert (Lernziele, Ablauf mit Phasen und
// Zeiten, ausformulierte Materialien, Hausaufgabe) und frei (eigener
// Prompt). Gespeicherte Pläne sind standardmässig privat und optional für
// Kolleginnen/Kollegen freigegeben.
// ————————————————————————————————————————————————————————————————

/// Generierungsmodus: strukturierter Lektionsplan oder freier Prompt.
enum KiModus {
  STRUKTUR
  FREI
}

model KiLektion {
  id          String  @id @default(cuid())
  titel       String
  modus       KiModus
  /// Thema (strukturiert) bzw. Kurzbeschreibung; im Freimodus der Prompt-Auszug.
  thema       String?
  /// Der effektiv an das Modell gesendete Prompt (System + User zusammengefasst).
  prompt      String
  /// Eingabeparameter (strukturiert): Sprache, Niveau, Kursart, Dauer,
  /// Lernziele, Zusatzhinweise. Im Freimodus nur der Prompt.
  parameter   Json?
  /// Ergebnis: strukturiert = { lernziele, ablauf, materialien, hausaufgabe };
  /// frei = { text }. Roh-JSON des Modells wird validiert gespeichert.
  ergebnis    Json?
  /// Modellname + Verbrauch/Dauer für die Kosten-Nachvollziehbarkeit.
  modell      String?
  tokenInput  Int?
  tokenOutput Int?
  dauerMs     Int?
  /// Freigabe für Kolleginnen/Kollegen (Bibliothek).
  geteilt     Boolean @default(false)

  erstelltVonUserId String
  erstelltVon       User   @relation("KiLektionen", fields: [erstelltVonUserId], references: [id], onDelete: Cascade)
  /// Snapshot des Namens (bleibt lesbar, falls das Konto später gelöscht wird).
  erstelltVonName   String

  spracheId String?
  sprache   Sprache? @relation(fields: [spracheId], references: [id], onDelete: SetNull)
  niveauId  String?
  niveau    Niveau?  @relation(fields: [niveauId], references: [id], onDelete: SetNull)
  kursartId String?
  kursart   Kursart? @relation(fields: [kursartId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([erstelltVonUserId, createdAt])
  @@index([geteilt, createdAt])
  @@index([createdAt])
}
