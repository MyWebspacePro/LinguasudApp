{
  "name": "linguasud-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma contract emit",
    "db:plan": "prisma migration plan",
    "db:migrate": "prisma db migrate --advance-ref db",
    "db:deploy": "prisma db migrate",
    "db:sign": "prisma db sign",
    "db:verify": "prisma db verify",
    "db:status": "prisma migration status",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose stop db"
  },
  "dependencies": {
    "@prisma/orm-postgres": "8.0.0-rc.20",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.9",
    "next": "16.4.2",
    "nodemailer": "^10.2.1",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@prisma/cli-engine": "0.9.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "prisma": "8.0.0-rc.27",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.14.0"
}
