# --- Datenbank (lokal: docker compose up -d db) ---
DATABASE_URL=postgresql://linguasud:linguasud@localhost:5432/linguasud?schema=public

# --- App ---
APP_ENV=development
APP_URL=http://localhost:3000

# --- Erstes Admin-Konto (Bootstrap, nur wenn DB leer; Modul 1) ---
# Passwort-Politik: min. 20 Zeichen, Gross/Klein, Ziffer, Sonderzeichen.
# Wechsel wird beim ersten Login erzwungen. Nur in Coolify setzen, nicht committen!
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_FIRST_NAME=
BOOTSTRAP_ADMIN_LAST_NAME=
BOOTSTRAP_ADMIN_PASSWORD=

# --- E-Mail (IONOS SMTP) — Passwort-Reset/Einladungen ---
# Typisch: smtp.ionos.de, Port 587 (STARTTLS)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Linguasud Verwaltung <noreply@aiconso.eu>"

# --- Schweizer QR-Rechnung (Modul 9) ---
# QR-IBAN der Schule (QR-IID 30000–31999) + Schulinstitution als Zahlungsempfänger.
# Ohne Konfiguration wird der QR-Zahlteil nicht erzeugt (Fehlermeldung in der UI).
# Lokale Dummy-Werte zum Testen; in Coolify die echten Werte eintragen.
QR_RECHNUNG_QR_IBAN=
QR_RECHNUNG_NAME=
QR_RECHNUNG_STRASSE=
QR_RECHNUNG_PLZ=
QR_RECHNUNG_ORT=
QR_RECHNUNG_LAND=CH
